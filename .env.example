# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않는다.
# API 키를 소스코드나 커밋 메시지에 절대 적지 말 것.

# ---------------------------------------------------------------------------
# 어떤 LLM 을 쓸지
#   anthropic / openai / mock
#   비워두면 사용 가능한 키를 찾아 자동 선택하고, 키가 없으면 mock 으로 떨어진다.
# ---------------------------------------------------------------------------
# FINAGENT_LLM_PROVIDER=anthropic

# --- Anthropic (https://console.anthropic.com/settings/keys) ---
# 주의: Claude Max 구독은 API 사용권이 아니다. 콘솔에서 별도 결제가 필요하다.
ANTHROPIC_API_KEY=
# 비워두면 claude-opus-5 를 쓴다.
# ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (https://platform.openai.com/api-keys) ---
# 주의: ChatGPT Plus 구독도 API 사용권이 아니다. 플랫폼에서 별도 결제가 필요하다.
OPENAI_API_KEY=
# openai 를 쓰려면 반드시 지정해야 한다 (모델 ID 라인업이 자주 바뀌어 기본값을 두지 않는다).
# 사용 가능한 ID: https://platform.openai.com/docs/models
# OPENAI_MODEL=
